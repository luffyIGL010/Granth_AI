        },
        {
            "text": "इस ताकत को भगवान का नाम दे दिया वह जानते",
            "start": 301.6,
            "duration": 5.52
        },
        {
            "text": "थे कि उनकी समस्याओं का समाधान एक शक्ति",
            "start": 304.52,
            "duration": 5.44
        },
        {
            "text": "कर सकती है जो सभी कुछ ऑटोमेटिक चला रही",
            "start": 307.12,
            "duration": 5.799
        },
        {
            "text": "है उनका मानना था कि अगर उस शक्ति को खुश",
            "start": 309.96,
            "duration": 5.239
        },
        {
            "text": "कर दिया जाए तो उनकी सभी समस्याओं का",
            "start": 312.919,
            "duration": 5.321
        },
        {
            "text": "समाधान हो सकता है बस इसी विचार ने इंसान",
            "start": 315.199,
            "duration": 5.72
        },
        {
            "text": "के दिमाग में पॉलीथिन रिलीजन के विचार को",
            "start": 318.24,
            "duration": 5.679
        },
        {
            "text": "जन्म दिया दिलचस्प बात थी कि यह सोच केवल",
            "start": 320.919,
            "duration": 5.56
        },
        {
            "text": "एक ही कबीले तक सीमित नहीं थी बल्कि हर",
            "start": 323.919,
            "duration": 5.241
        },
        {
            "text": "कबीले के इंसान में पनप रही थी और वह उन",
            "start": 326.479,
            "duration": 5.16
        },
        {
            "text": "सभी को खुश करने के लिए अलग-अलग रास्तों",
            "start": 329.16,
            "duration": 5.36
        },
        {
            "text": "को अपना रहे थे अगर आप सोच रहे हैं कि भला",
            "start": 331.639,
            "duration": 5.84
        },
        {
            "text": "पॉलिथीन रिलीजन क्या था तो आपको बता दें",
            "start": 334.52,
            "duration": 5.92
        },
        {
            "text": "कि इसका सीधा सा मतलब था बहु देवात यानी",
            "start": 337.479,
            "duration": 5.521
        },
        {
            "text": "कि ताकत को ना मानकर बहुत सारे देवों में",
            "start": 340.44,
            "duration": 5.4
        },
        {
            "text": "विश्वास रखना उदाहरण के तौर पर हिंदू धर्म",
            "start": 343.0,
            "duration": 6.16
        },
        {
            "text": "बहुदी सोच में पनपा और उनके साथ रोमन",
            "start": 345.84,
            "duration": 6.079
        },
        {
            "text": "गॉड्स एस्टेक गॉड्स और मायन गॉड्स भी",
            "start": 349.16,
            "duration": 5.879
        },
        {
            "text": "बहुदी सोच का हिस्सा रहे शुरुआती दौर से",
            "start": 351.919,
            "duration": 5.84
        },
        {
            "text": "ही धर्म में इतनी भिन्नता का मतलब था कि",
            "start": 355.039,
            "duration": 5.361
        },
        {
            "text": "अलग-अलग जगहों पर लोगों ने अपनी मान्यताओं",
            "start": 357.759,
            "duration": 5.681
        },
        {
            "text": "के हिसाब से धर्म को मानना शुरू किया जो",
            "start": 360.4,
            "duration": 5.96
        },
        {
            "text": "ताकत होमो सेपियंस के हाथ में नहीं थी उसे",
            "start": 363.44,
            "duration": 5.159
        },
        {
            "text": "मानने के लिए उन्होंने सुप्रीम ताकतों को",
            "start": 366.36,
            "duration": 4.88
        },
        {
            "text": "खुश करने का रास्ता अपनाया इसके लिए सबसे",
            "start": 368.599,
            "duration": 4.801
        },
        {
            "text": "पहले उन्होंने जानवरों की बलि देना शुरू",
            "start": 371.24,
            "duration": 4.84
        },
        {
            "text": "किया ताकि भारी मात्रा में अच्छी फसल हो",
            "start": 373.4,
            "duration": 5.239
        },
        {
            "text": "सके तूफान को रोकने के लिए उन्होंने हवा",
            "start": 376.08,
            "duration": 5.16
        },
        {
            "text": "के देवता का सहारा लिया अकाल पड़ने से",
            "start": 378.639,
            "duration": 4.921
        },
        {
            "text": "रोकने के लिए उन्होंने पानी को पूजना शुरू",
            "start": 381.24,
            "duration": 5.079
        },
        {
            "text": "किया ताकि भरपूर बारिश हो और पूरे साल",
            "start": 383.56,
            "duration": 5.199
        },
        {
            "text": "पानी की कमी ना हो देखा जाए तो अभी भी",
            "start": 386.319,
            "duration": 5.521
        },
        {
            "text": "इंसान प्रक की पूजा कर रहा था लेकिन अब वह",
            "start": 388.759,
            "duration": 5.401
        },
        {
            "text": "उन्हें देवों का रूप दे चुका था और उन्हें",
            "start": 391.84,
            "duration": 4.759
        },
        {
            "text": "खुश करने के लिए अलग-अलग मान्यताओं को",
            "start": 394.16,
            "duration": 4.8
        },
        {
            "text": "बनाने लगा था इसी के साथ जन्म हुआ",
            "start": 396.599,
            "duration": 5.72
        },
        {
            "text": "अजीबोगरीब रस्मो रिवाज का जो हर जनजाति का",
            "start": 398.96,
            "duration": 6.28
        },
        {
            "text": "प्रमुख हिस्सा था सभी जनजाति के देव अलग",
            "start": 402.319,
            "duration": 5.16
        },
        {
            "text": "थे और उन्हें खुश करने के लिए अलग-अलग",
            "start": 405.24,
            "duration": 5.2
        },
        {
            "text": "रस्मों रिवाजों को अपनाया जाता था उदाहरण",
            "start": 407.479,
            "duration": 5.641
        },
        {
            "text": "के तौर पर किसी जनजाति का राजा एक ही समय",
            "start": 410.44,
            "duration": 5.4
        },
        {
            "text": "में 50 भेड़ों की बलि चढ़ाता था क्योंकि",
            "start": 413.12,
            "duration": 5.6
        },
        {
            "text": "उनका मानना था कि भेड़ों की बलि से फसल के",
            "start": 415.84,
            "duration": 5.039
        },
        {
            "text": "देवता खुश हो होते हैं वहीं किसी दूसरी",
            "start": 418.72,
            "duration": 4.919
        },
        {
            "text": "जनजाति में फसल के देवता को खुश करने के",
            "start": 420.879,
            "duration": 5.401
        },
        {
            "text": "लिए कोई दूसरा रास्ता अपनाया जाता था",
            "start": 423.639,
            "duration": 5.041
        },
        {
            "text": "हैरानी की बात थी कि यह तो केवल धर्म के",
            "start": 426.28,
            "duration": 5.28
        },
        {
            "text": "विकास का दूसरा पड़ाव था अभी भी धर्म अपने",
            "start": 428.68,
            "duration": 5.32
        },
        {
            "text": "उस स्वरूप में नहीं विकसित हुआ था जिसमें",
            "start": 431.56,
            "duration": 5.56
        },
        {
            "text": "हम उसे जानते थे अभी तक लोगों के जहन में",
            "start": 434.0,
            "duration": 5.28
        },
        {
            "text": "केवल प्राकृतिक शक्तियों की पूजा का ख्याल",
            "start": 437.12,
            "duration": 4.799
        },
        {
            "text": "पनप रहा था लेकिन यह भी जल्द ही बदलने",
            "start": 439.28,
            "duration": 5.479
        },
        {
            "text": "वाला था धीरे-धीरे अपनी विचारधाराओं और",
            "start": 441.919,
            "duration": 5.28
        },
        {
            "text": "मान्यताओं को लेकर लोगों में कट्टरवादी",
            "start": 444.759,
            "duration": 4.801
        },
        {
            "text": "विचारधाराओं का जन्म हुआ लोग अपनी",
            "start": 447.199,
            "duration": 4.761
        },
        {
            "text": "मान्यताओं को और अपने देवों को सर्वशक्ति",
            "start": 449.56,
            "duration": 4.919
        },
        {
            "text": "के रूप में देखने लगे और ज्यादा से ज्यादा",
            "start": 451.96,
            "duration": 4.919
        },
        {
            "text": "संख्या में लोगों को अपनी ओर आकर्षित करने",
            "start": 454.479,
            "duration": 5.44
        },
        {
            "text": "का काम करने लगे कट्टरवादी मान्यताओं ने",
            "start": 456.879,
            "duration": 5.6
        },
        {
            "text": "कई स्तर पर लोगों को अपनी ओर आकर्षित करना",
            "start": 459.919,
            "duration": 5.201
        },
        {
            "text": "शुरू किया और यही मान्यताएं एक धर्म के",
            "start": 462.479,
            "duration": 5.28
        },
        {
            "text": "रूप में परिवर्तित होने लगी अब लोग एनीमि",
            "start": 465.12,
            "duration": 5.519
        },
        {
            "text": "जम और पॉलिथीन धर्म से निकलकर मिशनरी",
            "start": 467.759,
            "duration": 5.521
        },
        {
            "text": "रिलीजन की तरफ आकर्षित होने लगे मिशनरी",
            "start": 470.639,
            "duration": 5.12
        },
        {
            "text": "रिलीजन सिखाता था कि ज्यादा से ज्यादा",
            "start": 473.28,
            "duration": 5.319
        },
        {
            "text": "लोगों को अपने धर्म की तरफ प्रभावित कैसे",
            "start": 475.759,
            "duration": 5.44
        },
        {
            "text": "किया जाए जैसे कि हमने आपको बताया कि सभी",
            "start": 478.599,
            "duration": 5.28
        },
        {
            "text": "जनजाति और ग्रुप्स के अपनी-अपनी मान्यताओं",
            "start": 481.199,
            "duration": 5.241
        },
        {
            "text": "के हिसाब से अपने भगवान थे और वह उन्हीं",
            "start": 483.879,
            "duration": 5.32
        },
        {
            "text": "पर विश्वास रखते थे रोमन अंपायर की अगर",
            "start": 486.44,
            "duration": 5.159
        },
        {
            "text": "बात करें तो वहां के लोगों में ग्रीक गॉड",
            "start": 489.199,
            "duration": 5.041
        },
        {
            "text": "को लेकर काफी आस्था थी लेकिन मिशनरी",
            "start": 491.599,
            "duration": 5.6
        },
        {
            "text": "रिलीजन की वजह से ये भी जल्दी तबाह हो गए",
            "start": 494.24,
            "duration": 5.519
        },
        {
            "text": "क्योंकि यहूदी लोगों ने कई दूसरे लोगों को",
            "start": 497.199,
            "duration": 5.041
        },
        {
            "text": "अपनी ओर आकर्षित करना शुरू कर दिया था और",
            "start": 499.759,
            "duration": 5.4
        },
        {
            "text": "जीसस को सर्व शक्तिशाली भगवान के रूप में",
            "start": 502.24,
            "duration": 5.32
        },
        {
            "text": "दुनिया के सामने पेश किया यहूदियों की",
            "start": 505.159,
            "duration": 5.16
        },
        {
            "text": "धार्मिक किताब के हिसाब से जीसस ही वो",
            "start": 507.56,
            "duration": 5.44
        },
        {
            "text": "भगवान थे जिनके जन्म का दुनिया को इंतजार",
            "start": 510.319,
            "duration": 5.921
        },
        {
            "text": "था इससे पहले यहूदी यवे को अपना देवता",
            "start": 513.0,
            "duration": 5.76
        },
        {
            "text": "मानते थे लेकिन इस सोच ने लोगों को",
            "start": 516.24,
            "duration": 5.44
        },
        {
            "text": "विश्वास दिलाया कि जीसस ही उनके पहले असली",
            "start": 518.76,
            "duration": 5.04
        },
        {
            "text": "मसीहा थे और इसी तरह उदय हुआ",
            "start": 521.68,
            "duration": 4.24
        },
        {
            "text": "क्रिश्चियनिटी का क्रिश्चियनिटी ही वो",
            "start": 523.8,
            "duration": 4.8
        },
        {
            "text": "पहला धर्म था जिसने एक ही भगवान का विचार",
            "start": 525.92,
            "duration": 5.28
        },
        {
            "text": "दुनिया के सामने रखा इससे पहले प्राकृतिक",
            "start": 528.6,
            "duration": 5.52
        },
        {
            "text": "ताकतों के रूप में लोग कई देवी देवताओं को",
            "start": 531.2,
            "duration": 5.36
        },
        {
            "text": "पूछते थे लेकिन क्रिश्चियनिटी बहुत सारे",
            "start": 534.12,
            "duration": 5.64
        },
        {
            "text": "भगवान की बजाय केवल एक ही मसीहा को मान ने",
            "start": 536.56,
            "duration": 5.44
        },
        {
            "text": "की बात करता था शुरुआत में क्रिश्चियन",
            "start": 539.76,
            "duration": 4.68
        },
        {
            "text": "धर्म के लोग केवल अपने आप तक ही सीमित थे",
            "start": 542.0,
            "duration": 4.399
        },
        {
            "text": "वह अपने लोगों में रस्मों रिवाजों को",
            "start": 544.44,
            "duration": 4.8
        },
        {
            "text": "निभाते थे लेकिन धर्म को चारों तरफ फैलाने",
            "start": 546.399,
            "duration": 5.481
        },
        {
            "text": "का विचार उनके दिमाग में भी आया अब तक जो",
            "start": 549.24,
            "duration": 5.2
        },
        {
            "text": "धर्म केवल यहूदियों तक सीमित था अब वह",
            "start": 551.88,
            "duration": 5.28
        },
        {
            "text": "पूरे विश्व में फैलने वाला था इस धर्म को",
            "start": 554.44,
            "duration": 5.6
        },
        {
            "text": "लोगों तक फैलाने का काम किया पॉल ऑफ टर्स",
            "start": 557.16,
            "duration": 5.72
        },
        {
            "text": "ने उन्होंने लोगों को समझाया कि जो मसीहा",
            "start": 560.04,
            "duration": 5.32
        },
        {
            "text": "हमारी भलाई के लिए क्रॉस पर चढ़ गए और",
            "start": 562.88,
            "duration": 4.84
        },
        {
            "text": "इंसान को इंसानियत का पाठ पढ़ाने के लिए",
            "start": 565.36,
            "duration": 4.8
        },
        {
            "text": "दुनिया में आए उनके बारे में पूरी दुनिया",
            "start": 567.72,
            "duration": 5.08
        },
        {
            "text": "को पता चलना चाहिए यानी कि क्रिश्चियनिटी",
            "start": 570.16,
            "duration": 4.88
        },
        {
            "text": "केवल यहूदी तक सीमित नहीं होनी चाहिए",
            "start": 572.8,
            "duration": 4.68
        },
        {
            "text": "बल्कि यह हर किसी को इसके बारे में पता",
            "start": 575.04,
            "duration": 5.16
        },
        {
            "text": "होना चाहिए उनकी बातों से प्रभावित होकर",
            "start": 577.48,
            "duration": 5.0
        },
        {
            "text": "क्रिश्चन लोगों ने इस धर्म को पूरे विश्व",
            "start": 580.2,
            "duration": 4.6
        },
        {
            "text": "में फैलाने का काम किया क्रिश्चियनिटी की",
            "start": 582.48,
            "duration": 4.32
        },
        {
            "text": "लोकप्रियता तेजी से लोगों के बीच में",
            "start": 584.8,
            "duration": 4.76
        },
        {
            "text": "फैलने लगी क्योंकि एक ही सर्वशक्ति शली",
            "start": 586.8,
            "duration": 5.32
        },
        {
            "text": "देव को मानने का विचार लोगों के लिए नया",
            "start": 589.56,
            "duration": 5.48
        },
        {
            "text": "और अनोखा था ज्यादा से ज्यादा लोग इस धर्म",
            "start": 592.12,
            "duration": 4.76
        },
        {
            "text": "की तरफ खींचते चले गए और अपनी उन",
            "start": 595.04,
            "duration": 3.68
        },
        {
            "text": "मान्यताओं को छोड़कर लोगों ने",
            "start": 596.88,
            "duration": 4.079
        },
        {
            "text": "क्रिश्चियनिटी को अपनाया दोस्तों इससे",
            "start": 598.72,
            "duration": 4.52
        },
        {
            "text": "हमें पता चलता है कि धर्म का कांसेप्ट",
            "start": 600.959,
            "duration": 5.041
        },
        {
            "text": "हमेशा से इंसानों के बीच रहा लेकिन वक्त",
            "start": 603.24,
            "duration": 5.52
        },
        {
            "text": "के साथ उनकी परिभाषा कई मायनों में बदली",
            "start": 606.0,
            "duration": 5.12
        },
        {
            "text": "इस वीडियो में आप यह तो जान गए कि धर्म",
            "start": 608.76,
            "duration": 4.68
        },
        {
            "text": "किस तरह से आगे बढ़ा और क्रिश्चियनिटी",
            "start": 611.12,
            "duration": 4.88
        },
        {
            "text": "कैसे विश्व में फैल गई लेकिन अगली वीडियो",
            "start": 613.44,
            "duration": 5.28
        },
        {
            "text": "में हम आपको बताएंगे कि कैसे हिंदू धर्म",
            "start": 616.0,
            "duration": 5.2
        },
        {
            "text": "का विकास हुआ आखिर वह अपनी शुरुआती दौर",
            "start": 618.72,
            "duration": 4.679
        },
        {
            "text": "में किस फॉर्म में था और उसका विकास कैसे",
            "start": 621.2,
            "duration": 5.0
        },
        {
            "text": "हुआ तो दोस्तों आपकी नजर में गॉड एक है या",
            "start": 623.399,
            "duration": 5.481
        },
        {
            "text": "यह डिपेंडेंट है अलग-अलग रिलीजन पर कमेंट",
            "start": 626.2,
            "duration": 5.16
        },
        {
            "text": "करके जरूर बताइए और अगर इस वीडियो से आपको",
            "start": 628.88,
            "duration": 4.28
        },
        {
            "text": "कुछ नया जानने या सीखने को मिला या फिर",
            "start": 631.36,
            "duration": 4.12
        },
        {
            "text": "इंटरेस्टिंग लगा तो प्लीज इस वीडियो को एक",
            "start": 633.16,
            "duration": 4.4
        },
        {
            "text": "लाइक करके अपने फ्रेंड्स और फैमिली में से",
            "start": 635.48,
            "duration": 4.64
        },
        {
            "text": "जरूर शेयर करें और यदि आप इस चैनल पर नए",
            "start": 637.56,
            "duration": 5.04
        },
        {
            "text": "हैं तो प्लीज इस चैनल को सब्सक्राइब करके",
            "start": 640.12,
            "duration": 4.92
        },
        {
            "text": "बेल नोटिफिकेशन आइकन को ऑन कर लीजिए ताकि",
            "start": 642.6,
            "duration": 4.4
        },
        {
            "text": "हमारे आने वाले वीडियोस आप मिस ना करें",
            "start": 645.04,
            "duration": 3.68
        },
        {
            "text": "मिलते हैं फिर किसी वीडियो में नए टॉपिक",
            "start": 647.0,
            "duration": 6.399
        },
        {
            "text": "के साथ तब तक के लिए नमस्कार",
            "start": 648.72,
            "duration": 4.679
        }
    ]
}